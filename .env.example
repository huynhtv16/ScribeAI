# Hạ tầng (docker-compose đã có giá trị mặc định)
DATABASE_URL=postgresql://scribe:scribe@postgres:5432/scribe
REDIS_URL=redis://redis:6379/0

# API dịch/tóm tắt tương thích OpenAI. Điền key của bạn tại đây.
TRANSLATION_API_KEY=
TRANSLATION_API_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4o-mini

# Faster-Whisper: dùng cpu/int8 hoặc cuda/float16
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Bot Playwright + FFmpeg (tên monitor lấy bằng: pactl list short sources)
MEETING_URL=
MEETING_ID=
API_URL=http://localhost:8000
AUDIO_SOURCE=default
